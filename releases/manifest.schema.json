{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/release-manifest-v1.json",
  "title": "Linxira OS release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "acceptance",
    "createdAt",
    "iso",
    "sources",
    "packages",
    "build",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "acceptance": {
      "enum": ["rejected-diagnostic", "candidate", "accepted-release"]
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "iso": {"$ref": "#/$defs/artifact"},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archManifest", "linxiraManifest", "repositoryDatabases"],
      "properties": {
        "archManifest": {"$ref": "#/$defs/artifact"},
        "linxiraManifest": {"$ref": "#/$defs/artifact"},
        "repositoryDatabases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "filesystem", "toolVersions"],
      "properties": {
        "builder": {"type": "string", "minLength": 1},
        "filesystem": {"type": "string", "minLength": 1},
        "toolVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "sbom": {"$ref": "#/$defs/artifact"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "record"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not-run"]},
          "record": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
